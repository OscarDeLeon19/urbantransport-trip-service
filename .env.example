# Perfil y puerto (nginx hace proxy desde el 80 a este puerto)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# Base de datos
DB_HOST=
DB_PORT=5432
DB_NAME=trip_db
DB_USER=
DB_PASSWORD=

# Kafka (IP privada de la EC2 de Kafka)
KAFKA_BOOTSTRAP=localhost:9092

# Identity (IP privada de su EC2, sin puerto porque pasa por nginx)
IDENTITY_JWKS_URI=http://<IP_PRIVADA_IDENTITY>/.well-known/jwks.json

# Otros servicios (IP privada de cada EC2, sin puerto)
FLEET_URL=http://<IP_PRIVADA_FLEET>
TICKETING_URL=http://<IP_PRIVADA_TICKETING>

# Clave compartida con identity, customer, fleet y trip (debe ser idéntica en todos)
# Generar con: openssl rand -base64 32
INTERNAL_API_KEY=